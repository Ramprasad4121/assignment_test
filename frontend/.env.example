# API Configuration
VITE_API_URL=http://localhost:5007

# Application Configuration
VITE_APP_NAME=Student Management System
VITE_APP_VERSION=1.0.0

# Environment
NODE_ENV=development

# Blockchain — certificate verification (Problem 3)
# Deploy with `forge script script/Deploy.s.sol` in `blockchain/`, then paste the address.
VITE_CERT_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
# 31337 = Anvil local, 11155111 = Sepolia
VITE_CHAIN_ID=11155111
# Optional: Pinata JWT for real IPFS pins. Without it the UI uses an
# offline deterministic placeholder CID (demo mode).
VITE_PINATA_JWT= 